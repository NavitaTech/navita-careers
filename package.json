{
  "name": "uk-campus-drop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run logos && eslint src && tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "node scripts/run-node.mjs scripts/selftest.ts",
    "typecheck": "tsc --noEmit",
    "map": "node scripts/build-map.ts",
    "map:preview": "node scripts/preview-map.ts",
    "map:review": "node scripts/run-node.mjs scripts/build-review.ts",
    "fonts": "node scripts/fetch-fonts.ts",
    "sounds": "node scripts/build-sounds.ts",
    "labels": "node scripts/run-node.mjs scripts/check-labels.ts",
    "icons": "node scripts/run-node.mjs scripts/build-icons.ts",
    "render-test": "node scripts/run-node.mjs scripts/rendertest.tsx",
    "logos": "node scripts/run-node.mjs scripts/build-logo-manifest.ts",
    "lint": "eslint src scripts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "canvas-confetti": "^1.9.3",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.23.12",
    "howler": "^2.2.4",
    "idb": "^8.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-geo": "^3.1.0",
    "@types/howler": "^2.2.12",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
